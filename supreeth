def isBalanced(s):
    
    stack = []
    
    
    bracket_map = {')': '(', '}': '{', ']': '['}
    
    
    for char in s:
        
        if char in bracket_map:
           
            top_element = stack.pop() if stack else '#'
            if bracket_map[char] != top_element:
                return "NO"
        else:
            
            stack.append(char)
    
    
    return "YES" if not stack else "NO"


n = int(input())


for _ in range(n):
    s = input().strip()
    print(isBalanced(s))

class QueueUsingTwoStacks:
    def __init__(self):
        self.in_stack = []
        self.out_stack = []

    def enqueue(self, x):
        self.in_stack.append(x)

    def dequeue(self):
        if not self.out_stack:
            while self.in_stack:
                self.out_stack.append(self.in_stack.pop())
        if self.out_stack:
            self.out_stack.pop()

    def front(self):
        if not self.out_stack:
            while self.in_stack:
                self.out_stack.append(self.in_stack.pop())
        if self.out_stack:
            return self.out_stack[-1]

QUEUE USING TWO STACK
def process_queries(queries):
    queue = QueueUsingTwoStacks()
    for query in queries:
        query_type = query[0]
        
        if query_type == 1:
            queue.enqueue(query[1])
        elif query_type == 2:
            queue.dequeue()
        elif query_type == 3:
            print(queue.front())



n = int(input()) 
queries = []

for _ in range(n):
    query = list(map(int, input().split()))
    queries.append(query)

process_queries(queries)



